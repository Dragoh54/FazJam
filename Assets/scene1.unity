  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tYou push the gates and with a creak they open. You run towards the treeline,
    feeling the weight on your feet starting to lift.\r\n\tClutching the Stone in
    your hand, you look back at the mansion through the trees. The previously dark
    structure is suddenly beaming with light coming from every window. The gut-wrenching
    howl of a thousand voices reaches you, making you freeze for a moment.\r\n\t\u201CThat\u2019s
    enough of challenges for me\u201D, you mumble as you turn towards the road."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6553708be1b72da4fa48cef9bfc77405, type: 2}
