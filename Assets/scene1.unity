  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tYour goal is to find the Philosopher\u2019s Stone hidden somewhere inside
    the mansion. However, you can only travel through a limited number of rooms before
    you become too exhausted to continue. Keep an eye on your step counter - don\u2019t
    let it reach zero, and remember that you\u2019ll also need enough steps to return
    to the entrance.\r\n\tThroughout the mansion, you\u2019ll find valuable items
    that you can pick up. Once you\u2019ve gathered enough, return to the gargoyle
    statue to sell them. The money you earn can be spent on food to restore your
    current steps or on upgrades that increase your maximum number of steps. You
    can also find food scattered throughout the mansion for free, so keep an eye
    out when exploring.\r\n\tRemember, the main gate will be open only if you have
    found the Philosopher\u2019s Stone and have successfully returned to the entrance.
    Fail to do so, and you will be just another ghost wandering the halls of the
    mansion\u2026"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6553708be1b72da4fa48cef9bfc77405, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
