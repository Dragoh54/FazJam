  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tBeing the most notorious thief in the entire guild, your \u201Ccolleagues\u201D
    were used to challenging you to test your skills: the chief of police\u2019s
    baton, king\u2019s crown, Pope\u2019s mantle\u2026 That\u2019s why you were not
    impressed by a dare from a hooded figure to rob the abandoned mansion in the
    woods.\r\n\tThen you found yourself standing in front of the mansion, its walls
    stretching farther than you could see from the main gate. <b>Now</b> you were
    truly impressed. In the middle of the yard stood a gargoyle statue, shadows around
    it growing deeper the longer you looked. You touched the gargoyle\u2019s head,
    and suddenly a powerful gust of wind threw you to the ground. The creaky gate
    slammed shut behind you as you came to your senses. \r\n\tSomething was wrong.
    \r\n\tYour feet felt as if they were glued to the ground. It was hard to take
    even a single step.\r\n\tThe words flashed across the plaque beneath the gargoyle:\r\n\t\u201C<color=\"red\"
    ><i>One who dares to visit the mansion will be cursed to remain here until the
    end of their days.The only way to leave its grounds is to find the Philosopher\u2019s
    Stone deep inside. You can only take so many steps until you collapse. God have
    mercy on your soul</i></color>\u201D\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6553708be1b72da4fa48cef9bfc77405, type: 2}
  m_sharedMaterial: {fileID: -2636340113220039795, guid: 6553708be1b72da4fa48cef9bfc77405, type: 2}
